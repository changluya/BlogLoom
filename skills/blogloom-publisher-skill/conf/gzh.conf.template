# ============================================================
# 公众号（gzh）渠道发布配置「模板」
# ------------------------------------------------------------
# 复制为 conf/gzh.conf 后按需修改（conf/*.conf 已在 .gitignore 中忽略）。
#   cp conf/gzh.conf.template conf/gzh.conf
# 这里只放「渠道级发布选项」，不放文章自身属性（标题/标签/分类/
# 摘要/专栏等来自博客顶部 SOP 元数据，见 lib/markdown.js 解析）。
# 语法：key=value，一行一项，# 开头为注释；布尔值 true/false。
# CLI 参数（--author/--wechat-name/--collection/--group-send）
# 优先级高于本文件。
# ============================================================

# 作者栏（必填；缺失会导致「原创」弹窗无法勾选）
author=你的作者名

# 公众号名片名（正文顶部插入，留空则不插入）
wechatName=

# 合集名（留空则按文章 category 匹配；仍无匹配则跳过不选）
collection=

# 发表时是否群发（默认关闭）
groupSend=false

# 封面策略：first（自动选正文第一张图）/ none（不设置封面）
cover=first

# 描述（摘要）最大字数
summaryMaxLength=120

# 是否声明原创（文字原创 + 我已阅读 + 确定）
enableOriginal=true

# 是否开启赞赏（需先声明原创）
enableReward=true

# 是否开启付费（默认不开启）
enablePay=false

# 创作来源（单选文案）：个人观点，仅供参考 / 无需声明
creationSource=个人观点，仅供参考

# 正文样式化工具地址
mdStyleUrl=https://md.doocs.org/
