    "light": "/site-favicon.png",
    "dark": "/site-favicon.png"
  },
  "topbarCtaButton": {
    "name": "Star on GitHub",
    "type": "github",
    "url": "https://github.com/changluya/BlogLoom"
  },
  "anchors": [
