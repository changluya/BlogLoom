<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.changlu.blogloom.mapper.TagMapper">

    <resultMap id="tag" type="com.changlu.blogloom.entity.Tag">
        <id property="id" column="id"/>
        <result property="name" column="tag_name"/>
        <result property="color" column="color"/>
    </resultMap>

    <resultMap id="tagWithCount" type="com.changlu.blogloom.entity.Tag">
        <id property="id" column="id"/>
        <result property="name" column="tag_name"/>
        <result property="color" column="color"/>
        <result property="blogCount" column="blog_count"/>
    </resultMap>

    <!--获取所有标签List-->
    <select id="getTagList" resultMap="tag">
        select id, tag_name, color from tag order by id desc
    </select>

    <!--获取所有标签及各自已发布博客数量（含数量为0的标签）-->
    <select id="getTagListNotId" resultMap="tagWithCount">
        select t.id, t.tag_name, t.color, count(b.id) as blog_count
        from tag t
        left join blog_tag bt on bt.tag_id = t.id
        left join blog b on b.id = bt.blog_id and b.is_published = true
        group by t.id, t.tag_name, t.color
        order by t.id desc
    </select>

    <!--按博客id查询List-->
    <select id="getTagListByBlogId" resultMap="tag">
        select t.tag_name, t.color
        from blog_tag as bt left join tag as t on bt.tag_id=t.id
        where bt.blog_id=#{blogId}
    </select>

    <!--添加标签-->
    <insert id="saveTag" parameterType="com.changlu.blogloom.entity.Tag" useGeneratedKeys="true" keyProperty="id">
        insert into tag (tag_name, color) values (#{name}, #{color})
    </insert>

    <!--按id查询标签-->
    <select id="getTagById" resultMap="tag">
        select id, tag_name, color from tag where id=#{id}
    </select>

    <!--按name查询标签-->
    <select id="getTagByName" resultMap="tag">
        select id, tag_name, color from tag where tag_name=#{name}
    </select>

    <!--按id删除标签-->
    <delete id="deleteTagById">
        delete from tag where id=#{id}
    </delete>

    <!--更新标签-->
    <update id="updateTag">
        update tag set tag_name=#{name}, color=#{color} where id=#{id}
    </update>

    <resultMap id="tagBlogCount" type="com.changlu.blogloom.model.vo.TagBlogCount">
        <id property="id" column="tag_id"/>
        <result property="value" column="blog_count"/>
    </resultMap>

    <!--查询每个标签的博客数量-->
    <select id="getTagBlogCount" resultMap="tagBlogCount">
        select tag_id, count(tag_id) as blog_count from blog_tag group by tag_id
    </select>
</mapper>
