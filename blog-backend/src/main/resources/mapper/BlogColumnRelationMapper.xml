<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.changlu.blogloom.module.column.dao.BlogColumnRelationMapper">

    <!--按博客id查询其所属专栏id列表-->
    <select id="findColumnIdsByBlogId" resultType="java.lang.Long">
        select column_id from blog_column_relation where blog_id=#{blogId} order by id
    </select>

    <!--统计专栏下的关联记录数-->
    <select id="countByColumnId" resultType="int">
        select count(*) from blog_column_relation where column_id=#{columnId}
    </select>

    <!--按博客id删除专栏关联-->
    <delete id="deleteByBlogId">
        delete from blog_column_relation where blog_id=#{blogId}
    </delete>

    <!--批量新增博客与专栏关联-->
    <insert id="batchInsert">
        insert into blog_column_relation(column_id,blog_id,sort,create_time) values
        <foreach collection="columnIds" item="columnId" separator=",">
            (#{columnId},#{blogId},0,#{createTime})
        </foreach>
    </insert>
</mapper>
