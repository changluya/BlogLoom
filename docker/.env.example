# BlogLoom Docker 部署配置示例。
# 复制为 .env 后按需修改：cp .env.example .env
# deploy.sh / upgrade.sh 会在 .env 缺失时自动生成随机密码。

# 对外端口（均为非默认端口，可按需修改）
WEB_PORT=18080
MYSQL_PORT=13306

# 镜像版本（与 package.sh 打包时的版本保持一致；push.sh 也按此 tag 推送）
IMAGE_TAG=1.0.0

# 镜像仓库：本地构建/加载用 blogloom；从 Docker Hub 拉取用 codercl/blogloom
IMAGE_REPO=blogloom
# Docker Hub 用户名（push.sh 推送镜像时使用）
DOCKERHUB_USER=codercl

# MySQL
MYSQL_DATABASE=blogloom
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# 后端令牌密钥（请使用足够长的随机字符串）
TOKEN_SECRET=change-me

# 站点对外访问地址（影响上传资源、邮件与通知中的链接，务必填写真实地址）
BLOG_NAME=BlogLoom
BLOG_API=http://localhost:18080
BLOG_CMS=http://localhost:18080/cms
BLOG_VIEW=http://localhost:18080

# 运行参数（含空格的值请使用引号，便于脚本直接加载）
TZ=Asia/Shanghai
JAVA_OPTS="-Xms256m -Xmx512m"
